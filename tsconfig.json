{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@forgeadmin/shared": ["src/shared/src/index.ts"],
      "@forgeadmin/shared/*": ["src/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
