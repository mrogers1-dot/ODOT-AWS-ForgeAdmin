{
  "cmdlet": "Restart-Service",
  "category": "services",
  "description": "Restarts a Windows service",
  "target": { "objectType": "Service", "identifierParam": "Name" },
  "attributes": [
    { "name": "Status", "changeType": "set", "reversible": true }
  ],
  "probeCommands": [
    { "command": "Get-Service -Name {Name} | Select-Object Status", "outputAttribute": "Status" }
  ]
}
