{
  "cmdlet": "Set-ADAccountPassword",
  "category": "active-directory",
  "description": "Resets the password for an Active Directory user account",
  "target": { "objectType": "AD User", "identifierParam": "Identity" },
  "attributes": [
    { "name": "PasswordLastSet", "changeType": "set", "reversible": false }
  ],
  "probeCommands": [
    { "command": "Get-ADUser -Identity {Identity} -Properties PasswordLastSet | Select-Object PasswordLastSet", "outputAttribute": "PasswordLastSet" }
  ]
}
