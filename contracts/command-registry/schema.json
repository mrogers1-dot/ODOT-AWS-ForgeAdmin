{
  "$id": "https://forgeadmin.dot.ohio.gov/schemas/command-registry/command-effect",
  "title": "CommandEffect",
  "description": "Defines the predicted effects and probe commands for a PowerShell cmdlet",
  "type": "object",
  "required": ["cmdlet", "category", "target", "attributes", "probeCommands"],
  "properties": {
    "cmdlet": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "enum": ["active-directory", "dns", "services", "file-system", "group-policy", "networking"] },
    "description": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["objectType"],
      "properties": {
        "objectType": { "type": "string", "minLength": 1 },
        "identifierParam": { "type": "string" }
      }
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "changeType"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "changeType": { "type": "string", "enum": ["set", "add", "remove", "toggle"] },
          "reversible": { "type": "boolean" }
        }
      }
    },
    "probeCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "outputAttribute"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "outputAttribute": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
