{
  "title": "PlanProposed",
  "description": "Emitted when the Planning Agent generates an execution plan",
  "type": "object",
  "required": ["version", "correlationId", "timestamp", "source", "detailType", "payload"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "correlationId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "const": "forgeadmin.orchestration" },
    "detailType": { "type": "string", "const": "plan.proposed" },
    "payload": {
      "type": "object",
      "required": ["workItemId", "planId", "steps", "confidenceScore", "justification"],
      "properties": {
        "workItemId": { "type": "string", "format": "uuid" },
        "planId": { "type": "string", "format": "uuid" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["stepIndex", "description", "expectedOutcome", "rollback"],
            "properties": {
              "stepIndex": { "type": "integer", "minimum": 1 },
              "description": { "type": "string", "minLength": 1 },
              "expectedOutcome": { "type": "string", "minLength": 1 },
              "rollback": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "confidenceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidenceFactors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["factor", "weight"],
            "properties": {
              "factor": { "type": "string" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "justification": { "type": "string", "minLength": 1 },
        "serviceNowTicketId": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
