{
  "title": "SteeringUpdated",
  "description": "Emitted when a steering rule is created, updated, or rolled back",
  "type": "object",
  "required": ["version", "correlationId", "timestamp", "source", "detailType", "payload"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "correlationId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "const": "forgeadmin.dashboard" },
    "detailType": { "type": "string", "const": "steering.updated" },
    "payload": {
      "type": "object",
      "required": ["steeringId", "action", "updatedBy"],
      "properties": {
        "steeringId": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "enum": ["created", "updated", "deleted", "rolledback"] },
        "updatedBy": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
